{
  "name": "afterfaith-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "wrangler dev ./dist/_worker.js",
    "deploy": "wrangler deploy",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "db:migrate:local": "wrangler d1 migrations apply afterfaith-guide --local",
    "db:migrate:remote": "wrangler d1 migrations apply afterfaith-guide --remote",
    "db:seed:local": "wrangler d1 execute afterfaith-guide --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute afterfaith-guide --remote --file=./seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.5.1",
    "astro": "6.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@cloudflare/workers-types": "4.20260517.1",
    "typescript": "6.0.3",
    "wrangler": "4.92.0"
  }
}
