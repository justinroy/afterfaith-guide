---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import TagPill from '../../components/TagPill.astro';

const scripts = await getCollection('scripts');
const script = scripts.find((entry) => entry.id.replace(/\.md$/, '') === Astro.params.slug);

if (!script) {
  return Astro.redirect('/scripts', 302);
}

const { Content } = await render(script);
---

<Layout title={script.data.title} description={script.data.description}>
  <article>
    <header class="page-intro">
      <div class="container article-header">
      <p class="eyebrow">{script.data.context}</p>
      <h1>{script.data.title}</h1>
      <p class="lede">{script.data.description}</p>
        <div class="tag-row">
        {script.data.tags.map((tag) => <TagPill label={tag} />)}
      </div>
      </div>
    </header>
    <div class="container article-layout">
      <aside class="article-aside">
        <a href="/scripts">All scripts</a>
        <a href="/support-now">Support now</a>
      </aside>
      <div class="prose">
      <Content />
    </div>
    </div>
  </article>
</Layout>
