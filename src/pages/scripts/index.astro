---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import ScriptCard from '../../components/ScriptCard.astro';

const scripts = (await getCollection('scripts')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const routeId = (id: string) => id.replace(/\.md$/, '');
---

<Layout title="Scripts">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Scripts</p>
      <h1>Words for moments that can feel hard to enter.</h1>
      <p class="lede">Use these as starting language. Edit them until they sound like you and fit your safety needs.</p>
    </div>
    <div class="container grid two">
      {scripts.map((script) => (
        <ScriptCard title={script.data.title} description={script.data.description} context={script.data.context} href={`/scripts/${routeId(script.id)}`} />
      ))}
    </div>
  </section>
</Layout>
