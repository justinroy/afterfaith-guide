---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const routeId = (id: string) => id.replace(/\.md$/, '');
---

<Layout title="Guides">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Guides</p>
      <h1>Practical help for complicated moments.</h1>
      <p class="lede">Use these guides to slow things down, sort what matters, and find a next step that fits your situation.</p>
    </div>
    <div class="container grid two">
      {guides.map((guide) => (
        <GuideCard title={guide.data.title} description={guide.data.description} stage={guide.data.stage} href={`/guides/${routeId(guide.id)}`} />
      ))}
    </div>
  </section>
</Layout>
