---
import Layout from '../components/Layout.astro';
import StageCard from '../components/StageCard.astro';
---

<Layout title="Start Here">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Start Here</p>
      <h1>Find the next step that feels safe enough.</h1>
      <p class="lede">You do not have to name your entire future before taking care of the next hour, the next conversation, or the next boundary.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid three">
      <StageCard title="Keep it private for now" text="If disclosure could affect housing, money, school, work, custody, or safety, you can move slowly." href="/guides/how-to-tell-religious-parents-you-no-longer-believe" />
      <StageCard title="Lower the intensity" text="If fear or grief is running high, choose grounding and support before debate or big decisions." href="/guides/fear-of-hell-after-leaving-religion" />
      <StageCard title="Find one steady person" text="A therapist, peer line, friend, or community can make the process less isolating." href="/resources" />
    </div>
  </section>
</Layout>

