---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Coming Soon"
  description="AfterFaith Guide is preparing a calm, practical resource library for people questioning, leaving, grieving, or rebuilding after religion."
>
  <section class="coming-soon">
    <div class="container coming-soon-inner">
      <div class="message">
        <p class="eyebrow">AfterFaith Guide</p>
        <h1>A calmer resource library is coming soon.</h1>
        <p class="lede">
          We are preparing practical, endpoint-neutral support for people questioning, leaving,
          grieving, or rebuilding after religion.
        </p>
        <p>
          The full guide is being shaped with care. For now, this page is a quiet placeholder while
          the library is reviewed and organized.
        </p>
        <div class="button-row" aria-label="Helpful places to begin">
          <a class="button" href="/support-now">I need support now</a>
          <a class="button secondary" href="/about">About the project</a>
        </div>
      </div>

      <aside class="note" aria-label="Project values">
        <h2>Built to stay steady</h2>
        <ul>
          <li>No pressure toward one ending</li>
          <li>No ads, accounts, or unnecessary tracking</li>
          <li>Plain language for difficult moments</li>
        </ul>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .coming-soon {
    align-items: center;
    background:
      linear-gradient(135deg, rgba(47, 111, 115, 0.1), transparent 42%),
      var(--surface-strong);
    border-bottom: 1px solid var(--line);
    display: flex;
    min-height: calc(100vh - 210px);
    padding: clamp(42px, 8vw, 92px) 0;
  }

  .coming-soon-inner {
    align-items: center;
    display: grid;
    gap: 28px;
  }

  .message {
    max-width: 760px;
  }

  .message > p:not(.eyebrow, .lede) {
    color: var(--muted);
    font-size: 1.02rem;
    margin: 16px 0 0;
    max-width: 650px;
  }

  .note {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 20px;
  }

  .note h2 {
    font-size: 1.18rem;
  }

  .note ul {
    color: var(--muted);
    margin: 14px 0 0;
    padding-left: 20px;
  }

  .note li + li {
    margin-top: 8px;
  }

  @media (min-width: 860px) {
    .coming-soon-inner {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    }
  }
</style>
