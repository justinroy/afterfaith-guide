---
import { getCollection } from 'astro:content';
import { env } from 'cloudflare:workers';
import Layout from '../components/Layout.astro';
import StageCard from '../components/StageCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import GuideCard from '../components/GuideCard.astro';
import { getFeaturedResources, type Resource, type ResourceTag } from '../lib/resources';

const db = env.DB;
let featuredResources: { resources: Resource[]; tags: ResourceTag[] } = { resources: [], tags: [] };
if (db) {
  try {
    featuredResources = await getFeaturedResources(db, 4);
  } catch {
    featuredResources = { resources: [], tags: [] };
  }
}
const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const routeId = (id: string) => id.replace(/\.md$/, '');
const featuredArticles = articles.filter((article) => article.data.featured).slice(0, 2);
const latestArticles = articles.slice(0, 3);
---

<Layout title="AfterFaith Guide">
  <section class="home-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Resource library for life after religion</p>
        <h1>Find steady help without being pushed toward one ending.</h1>
        <p class="lede">Browse practical resources, articles, guides, and scripts for questioning, leaving, grieving, family pressure, religious trauma, and rebuilding.</p>
        <form class="quick-search" method="get" action="/resources" role="search">
          <label>
            <span>What kind of help do you need?</span>
            <select name="topic">
              <option value="">Browse all resources</option>
              <option value="therapy">Therapy</option>
              <option value="peer-support">Peer support</option>
              <option value="religious-trauma">Religious trauma</option>
              <option value="high-control">High-control groups</option>
              <option value="safety">Safety</option>
            </select>
          </label>
          <button class="button" type="submit">Search resources</button>
        </form>
      </div>
      <aside class="hero-directory">
        <h2>Start by situation</h2>
        <a href="/resources?stage=support-now">I need support now</a>
        <a href="/resources?stage=questioning">I am questioning</a>
        <a href="/resources?stage=leaving">I am leaving</a>
        <a href="/resources?stage=healing">I am healing from religious trauma</a>
        <a href="/resources?stage=rebuilding">I am rebuilding</a>
      </aside>
    </div>
  </section>

  <section class="section compact">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Featured resources</p>
          <h2>Reviewed places to begin</h2>
          <p>Use the labels for stance, intensity, cost, and fit before opening something new.</p>
        </div>
        <a href="/resources">Browse the full directory</a>
      </div>
      {featuredResources.resources.length > 0 ? (
        <div class="grid two">
          {featuredResources.resources.map((resource) => (
            <ResourceCard resource={resource} tags={featuredResources.tags.filter((tag) => tag.resource_id === resource.id)} />
          ))}
        </div>
      ) : (
        <p class="notice">Featured resources appear here when the D1 resource directory is available.</p>
      )}
    </div>
  </section>

  <section class="section muted-band">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Ways in</p>
          <h2>Choose the door that matches today</h2>
        </div>
      </div>
      <div class="grid four">
        <StageCard title="Slow down the first hour" text="Support-now reminders for safety, grounding, and urgent moments." href="/support-now" />
        <StageCard title="Understand what changed" text="Guides for doubt, fear, grief, family pressure, and identity shifts." href="/guides" />
        <StageCard title="Find words for hard talks" text="Scripts you can edit for boundaries, invitations, partners, parents, and therapists." href="/scripts" />
        <StageCard title="Compare support options" text="Articles about choosing resources without overwhelm or pressure." href="/articles" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container editorial-grid">
      <div>
        <div class="section-heading">
          <div>
            <p class="eyebrow">Featured articles</p>
            <h2>Editorial notes</h2>
          </div>
          <a href="/articles">All articles</a>
        </div>
        <div class="content-list">
          {(featuredArticles.length ? featuredArticles : latestArticles).map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              audience={article.data.audience}
              date={article.data.published}
              featured={article.data.featured}
              href={`/articles/${routeId(article.id)}`}
            />
          ))}
        </div>
      </div>
      <div>
        <div class="section-heading">
          <div>
            <p class="eyebrow">Core guides</p>
            <h2>Practical help</h2>
          </div>
          <a href="/guides">All guides</a>
        </div>
        <div class="content-list">
          {guides.map((guide) => (
            <GuideCard title={guide.data.title} description={guide.data.description} stage={guide.data.stage} href={`/guides/${routeId(guide.id)}`} />
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    background: var(--surface-strong);
    border-bottom: 1px solid var(--line);
    padding: clamp(36px, 8vw, 78px) 0;
  }

  .hero-grid {
    align-items: stretch;
    display: grid;
    gap: 22px;
  }

  .quick-search {
    align-items: end;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    display: grid;
    gap: 12px;
    margin-top: 24px;
    max-width: 760px;
    padding: 16px;
  }

  .quick-search label {
    display: grid;
    gap: 6px;
  }

  .quick-search span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .quick-search select {
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--text);
    font: inherit;
    min-height: 42px;
    padding: 8px;
  }

  .hero-directory {
    background: var(--ink);
    border-radius: 6px;
    color: white;
    display: grid;
    gap: 8px;
    padding: 20px;
  }

  .hero-directory h2 {
    color: white;
    font-size: 1.12rem;
    margin-bottom: 4px;
  }

  .hero-directory a {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    color: white;
    font-weight: 750;
    padding-top: 9px;
    text-decoration: none;
  }

  .muted-band {
    background: var(--surface-muted);
    border-block: 1px solid var(--line);
  }

  .editorial-grid {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    }

    .quick-search {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .editorial-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
</style>
