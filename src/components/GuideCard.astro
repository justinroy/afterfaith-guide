---
type Props = {
  title: string;
  description: string;
  href: string;
  stage: string;
};

const { title, description, href, stage } = Astro.props;
---

<article class="content-card">
  <p class="meta">{stage}</p>
  <h2><a href={href}>{title}</a></h2>
  <p>{description}</p>
</article>

<style>
  .content-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 18px;
  }

  .meta {
    color: var(--sage);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  h2 {
    font-size: 1.08rem;
    line-height: 1.25;
    margin: 0 0 10px;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-dark);
    text-decoration: underline;
  }

  p:last-child {
    color: var(--muted);
    margin: 0;
  }
</style>
