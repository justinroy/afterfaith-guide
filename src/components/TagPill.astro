---
type Props = {
  label: string;
};

const { label } = Astro.props;
---

<span class="tag">{label}</span>

<style>
  .tag {
    background: var(--surface-muted);
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--muted);
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 650;
    padding: 4px 10px;
  }
</style>
